# Configuración local de Claude Code (no compartir)
.claude/

# Copias/respaldo antiguos
verificacion.zip
*.bak
*.tmp

# Notas/ideas personales (no compartir en el repo público)
contratos/local.html

# Basura del sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Logs
*.log

# Dependencias (por si en el futuro se agregan)
node_modules/

# Caché/estado local del CLI de Supabase
supabase/.temp/
supabase/.branches/

# Datos sensibles: credenciales, usuarios, contraseñas, tokens, SQLs de administración
usuarios*.csv
usuarios*.xlsx
*credenciales*
*password*
*passwords*
crear-admin*.js
*.sql
!supabase/migrations/*.sql

# Vista previa generada para revisar el diseño (no es parte de la app)
vista-previa-*.html

# Manual del IPAT: 17 MB. El repo es público y esto quedaría en el historial
# para siempre; se consulta aparte, no hace falta versionarlo.
Resolucion_*.pdf

# Exportaciones de fotos desde Drive: gigabytes de imagenes historicas.
# Se suben a Supabase Storage, no al repo.
*_Images-*.zip

# Rastro local de la subida de fotos historicas (no es parte del aplicativo)
supabase/herramientas/subidos.txt
supabase/herramientas/fallidos.txt
supabase/herramientas/subida.log

# Caché de Python (la generan las herramientas de supabase/herramientas)
__pycache__/
